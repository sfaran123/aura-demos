# android/ is committed: it holds the Dejavoo Tap to Pay setup (native handler, Gradle).
# Its own .gitignore keeps local.properties, keystores and the SDK AARs out.
# ios/ is generated by `flutter create` in CI.
ios/
.metadata
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
*.iml
.idea/
# Local build settings with secrets (AURA_VERIFY_KEY), never committed
dart_defines.json

# flutter create (any platform) regenerates the template test; it does not fit this app
test/widget_test.dart
